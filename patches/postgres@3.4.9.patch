diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..29b10bedb0fb8a5bbb4e26325dd85ac6167a4a02 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -135,7 +135,24 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
         ? (await Promise.resolve(options.socket(options)))
         : new net.Socket()
     } catch (e) {
+      // PATCH HOM-441 (paperclip): pool-slot leak on a pre-connect socket-
+      // factory rejection. A custom `socket` factory (see the "Custom
+      // socket" README section) can reject its promise before ever handing
+      // back a socket -- our own inactivity-timeout factory does this on a
+      // dial timeout or an OS-level pre-connect error/close. `error(e)`
+      // alone only rejects whatever query is already queued on this
+      // connection; it never moves `connection` out of the pool's
+      // `connecting` queue, because that only happens via the `close`
+      // listener attached below -- which this catch branch returns from
+      // before ever reaching. With no real socket to fire that listener,
+      // the connection is stranded in `connecting` forever, permanently
+      // holding one pool slot; with `max` connections all doing this, every
+      // future query queues forever with nothing to ever serve it. Calling
+      // `onclose` mirrors what a real socket's `close` event does: move the
+      // connection back to `closed` so the pool can retry it on the next
+      // query.
       error(e)
+      onclose(connection, e)
       return
     }
     x.on('error', error)
@@ -254,8 +271,24 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
   }
 
   function nextWrite(fn) {
-    const x = socket.write(chunk, fn)
     nextWriteTimer !== null && clearImmediate(nextWriteTimer)
+    if (socket === null) {
+      // PATCH HOM-421 (paperclip): null-socket write guard.
+      // The socket was torn down between this write being queued and the
+      // immediate firing: closed() and terminate() both set `socket = null`,
+      // and a queued nextWrite outlives them. Writing here throws
+      // `TypeError: Cannot read properties of null (reading 'write')` from a
+      // macrotask, which is an uncaughtException rather than a rejected
+      // query promise, so Node's default handler terminates the process.
+      // Dropping the buffered chunk is the correct outcome: it belongs to a
+      // connection that no longer exists, and the pool rebuilds and resends
+      // the query on the reconnect that closed() already scheduled.
+      // `false` matches what a destroyed Node socket returns.
+      chunk = nextWriteTimer = null
+      fn && fn(Errors.connection('CONNECTION_CLOSED', options, socket))
+      return false
+    }
+    const x = socket.write(chunk, fn)
     chunk = nextWriteTimer = null
     return x
   }
@@ -427,6 +460,7 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
       error(Errors.connection('CONNECTION_DESTROYED', options))
 
     clearImmediate(nextWriteTimer)
+    chunk = nextWriteTimer = null
     if (socket) {
       socket.removeListener('data', data)
       socket.removeListener('connect', connected)
@@ -440,6 +474,7 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     remaining = 0
     incomings = null
     clearImmediate(nextWriteTimer)
+    chunk = nextWriteTimer = null
     socket.removeListener('data', data)
     socket.removeListener('connect', connected)
     idleTimer.cancel()
